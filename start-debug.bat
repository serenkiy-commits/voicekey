@echo off
chcp 65001 >nul
cd /d "%~dp0.."
if not exist "%~dp0.venv\Scripts\python.exe" (
    echo Окружение .venv не найдено. Сначала запустите install.bat
    pause
    exit /b 1
)
echo ================================================================
echo  VoiceKey - режим отладки. ЭТО ОКНО НЕ ЗАКРЫВАЙТЕ.
echo  Здесь видны все сообщения и ошибки.
echo  Повторите проблему: нажмите CapsLock, скажите фразу, снова CapsLock.
echo  Затем пришлите этот вывод (или файл voicekey.log из папки voicekey).
echo ================================================================
"%~dp0.venv\Scripts\python.exe" -m voicekey.main
echo ================================================================
echo  Программа завершилась. Скопируйте текст выше и пришлите.
pause
